@model int

<div class="container row pt-4">
	<div class="col-12 text-center">
	
		<h1 class="text-primary text-center">Order Placed Successfully</h1>
		Your order number is: @Model<br/><br/>
		<img src="~/Images/AllImages/paymentSuccessful.png" width="35%" />
	</div>
	<div class="col-12 text-center" style="color:maroon">
		<br/>
		Your order has been placed successfully<br/>
		<a asp-area="Customer" asp-controller="Home" asp-action="Index"
		   asp-route-orderId="@Model" class="btn btn-primary">Back to Home</a>
	</div>
</div>