@{
    ViewData["Title"] = "Company Page";
}

<div class="card">

    <div class="card-header bg-primary bg-gradient m-lg-0 py-3 text-center">
        <h2 class="text-white">Company List</h2>
    </div>

    <div class="col-12 p-2 text-end">
        <a class="btn btn-success" asp-controller="Company" asp-action="Upsert"> <i class="bi bi-plus-circle"> Add Company</i></a>
    </div>


    <div class="card-body p-3">
        <table id="tblData" class="table table-bordered table-striped display" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>state</th>
                    <th>Phone Number</th>
                    <th></th>
                </tr>             
            </thead>
        </table>
    </div>
</div>
    

@section Scripts {
    <script src="~/js/company.js"></script>
}




