@model List<Category>
@{
    ViewData["Title"] = "Category Page";
}


<div class="card">

    <div class="card-header p-3 bg-success text-center">
        <h2 class="text-white">Category List</h2>
     </div>
        
    <div class="col-12 p-2 text-end">
        <a class="btn btn-success" asp-controller="Category" asp-action="Create"> <i class="bi bi-plus-circle"> Add Category</i></a>
    </div>


    <div class="card-body p-3">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Available Movie</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var obj in Model.OrderBy(u => u.DisplayOrder))
                {
                    <tr>
                        <td>@obj.Name</td>
                        <td>@obj.DisplayOrder</td>
                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a class="btn btn-info mx-2" asp-controller="Category" asp-action="Edit" asp-route-id="@obj.Id"> <i class="bi bi-pencil-square"> Edit</i></a>
                                <a class="btn btn-danger mx-2" asp-controller="Category" asp-action="Delete" asp-route-id="@obj.Id"> <i class="bi bi-trash3-fill"> Delete</i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>





