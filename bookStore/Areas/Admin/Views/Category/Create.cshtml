@model Category
@{
	ViewData["Title"] = "Create Page";
}


<div class="container">
	<form asp-action="Create" method="post">
		<div class="border p-3 mt-4">
			<div class="row p-3">
				<h2 class="text-info">Create Category</h2>
			</div>

			<div class="mb-3">
				<label asp-for="Name"></label>
				<input asp-for="Name" class="form-control" />
				<span asp-validation-for="Name" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="DisplayOrder"></label>
				<input asp-for="DisplayOrder" class="form-control" />
				<span asp-validation-for="DisplayOrder" class="text-danger"></span>
			</div>

			<div class="row p-3">
				<div class="col-6">
					<button type="submit" class="btn btn-info form-control">
						<i class="bi bi-check-circle-fill"> Create</i>
					</button>
				</div>

				<div class="col-6">
					<a class="btn btn-primary form-control" asp-controller="Category" asp-action="Index">
						<i class="bi bi-arrow-left-circle"> Back to List</i>
					</a>
				</div>
			</div>

		</div>
	</form>

</div>



