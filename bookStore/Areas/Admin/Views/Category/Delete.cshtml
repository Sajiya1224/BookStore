@model Category
@{
	ViewData["Title"] = "Delete Page";
}

<div class="card" >

	<div class="card-header p-3 bg-success text-center">
		<h2 class="text-white">Delete Category</h2>
	</div>
	 
	<div class="card-body row p-3">
		
			<form asp-action="Delete" method="post">
				<input asp-for="Id" hidden />

					<div class="py-2 col-12 form-floating">
						<label asp-for="Name" class="p-2"></label>
						<input asp-for="Name" class="form-control" disabled />

					</div>

					<div class="py-2 col-12 form-floating">
						<label asp-for="DisplayOrder" class="p-2"></label>
						<input asp-for="DisplayOrder" class="form-control" disabled />

					</div>

					<div class="row p-3">

						<div class="col-6">
							<button type="submit" class="btn btn-danger form-control">
								<i class="bi bi-trash3-fill"> Delete</i>
							</button>
						</div>

						<div class="col-6">
							<a class="btn btn-primary form-control" asp-controller="Category" asp-action="Index">
								<i class="bi bi-arrow-left-circle"> Back to List</i>
							</a>
						</div>

					</div>

			</form>
	</div>
</div>



